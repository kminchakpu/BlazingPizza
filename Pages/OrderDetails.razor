
@page "/order/{OrderId:int}"
@using System.Net
@using System.Net.Http.Json
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
<PageTitle>Order Details - Blazing Pizza</PageTitle>
<div class="main">
    <div class="checkout-page">
        <h1>Order Details</h1>
        @if (isLoading)
        {
            <div class="checkout-card">
                <p>Loading order details...</p>
            </div>
        }
        else if (orderNotFound)
        {
            <div class="checkout-card checkout-empty">
                <h2>Order Not Found</h2>
                <p>We couldn't find order #@OrderId.</p>
                <div class="checkout-actions">
                    <a class="btn btn-primary" href="/my-orders">Back to My Orders</a>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="checkout-card">
                <h2>Unable to Load Order</h2>
                <p>@errorMessage</p>
                <div class="checkout-actions">
                    <button class="btn btn-primary" @onclick="LoadOrder">Try Again</button>
                    <a class="btn btn-secondary" href="/my-orders">Back to My Orders</a>
                </div>
            </div>
        }
        else if (orderWithStatus != null)
        {
            <div class="checkout-card">
                <div class="checkout-summary">
                    <h2>Order #@orderWithStatus.Order.OrderId</h2>
                    <span class="order-status">@orderWithStatus.StatusText</span>
                </div>
                <p>
                    <strong>Order Date:</strong>
                    @orderWithStatus.Order.CreatedTime.ToString("dd MMM yyyy, hh:mm tt")
                </p>
                <p>
                    <strong>Order Status:</strong>
                    @orderWithStatus.StatusText
                </p>
                <h2>Customer Information</h2>
                <div class="order-customer-details">
                    <p><strong>Full Name:</strong> @(orderWithStatus.Order.DeliveryAddress?.Name ?? "Not provided")</p>
                    <p><strong>Email Address:</strong> @(orderWithStatus.Order.DeliveryAddress?.Email ?? "Not provided")</p>
                    <p><strong>Phone Number:</strong> @(orderWithStatus.Order.DeliveryAddress?.Phone ?? "Not provided")</p>
                </div>
                <h2>Delivery Address</h2>
                <div class="order-customer-details">
                    <p><strong>Street Address:</strong> @(orderWithStatus.Order.DeliveryAddress?.Line1 ?? "Not provided")</p>
                    @if (!string.IsNullOrWhiteSpace(orderWithStatus.Order.DeliveryAddress?.Line2))
                    {
                        <p><strong>Additional Information:</strong> @orderWithStatus.Order.DeliveryAddress.Line2</p>
                    }
                    <p><strong>City:</strong> @(orderWithStatus.Order.DeliveryAddress?.City ?? "Not provided")</p>
                    <p><strong>State:</strong> @(orderWithStatus.Order.DeliveryAddress?.Region ?? "Not provided")</p>
                    <p><strong>Postal Code:</strong> @(orderWithStatus.Order.DeliveryAddress?.PostalCode ?? "Not provided")</p>
                </div>
                <h2>Ordered Pizzas</h2>
                <div class="checkout-items">
                    @foreach (var pizza in orderWithStatus.Order.Pizzas)
                    {
                        <div class="checkout-item">
                            <div class="title">
                                @pizza.Size" @pizza.Special.Name
                            </div>
                            <div class="item-price">
                                @pizza.GetFormattedTotalPrice()
                            </div>
                        </div>
                    }
                </div>
                <div class="checkout-summary">
                    <strong>Order Total:</strong>
                    <strong class="total-price">
                        @orderWithStatus.Order.GetFormattedTotalPrice()
                    </strong>
                </div>
                <div class="checkout-actions">
                    <a class="btn btn-primary" href="/my-orders">Back to My Orders</a>
                    <a class="btn btn-success" href="/">Order More Pizza</a>
                </div>
            </div>
        }
    </div>
</div>
@code {
    [Parameter]
    public int OrderId { get; set; }
    private OrderWithStatus orderWithStatus;
    private bool isLoading = true;
    private bool orderNotFound;
    private string errorMessage;
    protected override async Task OnParametersSetAsync()
    {
        await LoadOrder();
    }
    private async Task LoadOrder()
    {
        isLoading = true;
        orderNotFound = false;
        errorMessage = null;
        orderWithStatus = null;
        try
        {
            var orderUrl = NavigationManager.ToAbsoluteUri($"orders/{OrderId}");
            var response = await HttpClient.GetAsync(orderUrl);
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                orderNotFound = true;
                return;
            }
            response.EnsureSuccessStatusCode();
            orderWithStatus = await response.Content.ReadFromJsonAsync<OrderWithStatus>();
            if (orderWithStatus == null)
            {
                errorMessage = "The server returned an empty order response.";
            }
        }
        catch (Exception)
        {
            errorMessage = "We couldn't retrieve this order. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
