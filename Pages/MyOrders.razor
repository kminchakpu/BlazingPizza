
@page "/my-orders"
@using System.Net.Http.Json
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
<PageTitle>My Orders - Blazing Pizza</PageTitle>
<div class="main">
    <div class="checkout-page">
        <h1>My Orders</h1>
        @if (isLoading)
        {
            <div class="checkout-card">
                <p>Loading your orders...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="checkout-card">
                <h2>Unable to Load Orders</h2>
                <p>@errorMessage</p>
                <button class="btn btn-primary" @onclick="LoadOrders">
                    Try Again
                </button>
            </div>
        }
        else if (!orders.Any())
        {
            <div class="checkout-card checkout-empty">
                <h2>No Orders Yet</h2>
                <p>You haven't placed any orders yet.</p>
                <div class="checkout-actions">
                    <button class="btn btn-primary" @onclick="ReturnToPizzaSelection">
                        Order a Pizza
                    </button>
                </div>
            </div>
        }
        else
        {
            @foreach (var order in orders)
            {
                <div class="checkout-card">
                    <div class="checkout-summary">
                        <h2>Order #@order.Order.OrderId</h2>
                        <span class="order-status">@order.StatusText</span>
                    </div>
                    <p>
                        <strong>Order Date:</strong>
                        @order.Order.CreatedTime.ToString("dd MMM yyyy, hh:mm tt")
                    </p>
                    <h2>Customer Information</h2>
                    <div class="order-customer-details">
                        <p><strong>Full Name:</strong> @(order.Order.DeliveryAddress?.Name ?? "Not provided")</p>
                        <p><strong>Email Address:</strong> @(order.Order.DeliveryAddress?.Email ?? "Not provided")</p>
                        <p><strong>Phone Number:</strong> @(order.Order.DeliveryAddress?.Phone ?? "Not provided")</p>
                    </div>
                    <h2>Delivery Address</h2>
                    <div class="order-customer-details">
                        <p><strong>Street Address:</strong> @(order.Order.DeliveryAddress?.Line1 ?? "Not provided")</p>
                        @if (!string.IsNullOrWhiteSpace(order.Order.DeliveryAddress?.Line2))
                        {
                            <p><strong>Additional Information:</strong> @order.Order.DeliveryAddress.Line2</p>
                        }
                        <p><strong>City:</strong> @(order.Order.DeliveryAddress?.City ?? "Not provided")</p>
                        <p><strong>State:</strong> @(order.Order.DeliveryAddress?.Region ?? "Not provided")</p>
                        <p><strong>Postal Code:</strong> @(order.Order.DeliveryAddress?.PostalCode ?? "Not provided")</p>
                    </div>
                    <h2>Ordered Pizzas</h2>
                    <div class="checkout-items">
                        @foreach (var pizza in order.Order.Pizzas)
                        {
                            <div class="checkout-item">
                                <div class="title">
                                    @pizza.Size" @pizza.Special.Name
                                </div>
                                <div class="item-price">
                                    @pizza.GetFormattedTotalPrice()
                                </div>
                            </div>
                        }
                    </div>
                    <div class="checkout-summary">
                        <strong>Total:</strong>
                        <strong class="total-price">
                            @order.Order.GetFormattedTotalPrice()
                        </strong>
                    </div>
                    <div class="checkout-actions">
                        <a class="btn btn-primary" href="@($"/order/{order.Order.OrderId}")">
                            View Order Details
                        </a>
                    </div>
                </div>
            }
        }
    </div>
</div>
@code {
    private List<OrderWithStatus> orders = new();
    private bool isLoading = true;
    private string errorMessage;
    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }
    private async Task LoadOrders()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var ordersUrl = NavigationManager.ToAbsoluteUri("orders");
            orders = await HttpClient.GetFromJsonAsync<List<OrderWithStatus>>(ordersUrl) ?? new();
        }
        catch (Exception)
        {
            errorMessage = "We couldn't retrieve your orders. Please check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
    private void ReturnToPizzaSelection()
    {
        NavigationManager.NavigateTo("/");
    }
}
